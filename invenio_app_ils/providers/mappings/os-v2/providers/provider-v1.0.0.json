{
  "settings": {
    "analysis": {
      "analyzer": {
        "email": {
          "type": "custom",
          "tokenizer": "uax_url_email"
        },
        "accent_folding": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": ["lowercase", "asciifolding"]
        }
      }
    }
  },
  "mappings": {
    "date_detection": false,
    "numeric_detection": false,
    "properties": {
      "$schema": {
        "type": "keyword"
      },
      "_created": {
        "type": "date"
      },
      "_updated": {
        "type": "date"
      },
      "address": {
        "type": "text",
        "analyzer": "accent_folding"
      },
      "email": {
        "type": "text",
        "analyzer": "email"
      },
      "legacy_id": {
        "type": "keyword"
      },
      "name": {
        "fields": {
          "keyword": {
            "type": "keyword"
          }
        },
        "type": "text",
        "analyzer": "accent_folding"
      },
      "notes": {
        "type": "text",
        "analyzer": "accent_folding"
      },
      "phone": {
        "type": "keyword"
      },
      "pid": {
        "type": "keyword"
      },
      "type": {
        "type": "keyword"
      }
    }
  }
}
